# TracePilot 运行配置模板
# 使用方法：复制本文件为 .env 后填写；.env 已被 git 忽略，切勿提交真实密钥。

# --- DeepSeek API（必填） ---
# API Key（在 DeepSeek 开放平台生成，绝不提交到仓库）
DEEPSEEK_API_KEY=
# API 地址（OpenAI 兼容端点）
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名（2026-11 实测可用：deepseek-flash / deepseek-v4-pro；旧名仅兼容映射）
DEEPSEEK_MODEL=deepseek-flash
# 单次模型调用超时（秒）
DEEPSEEK_TIMEOUT=60

# --- 真实调用持久化预算（V2；强烈建议配置） ---
# 累计上游调用次数上限；0/未设置 = fail-closed（任何真实调用都被拒绝）
TRACEPILOT_REAL_TOTAL_CALL_LIMIT=
# 单访客每日真实调用上限
TRACEPILOT_REAL_VISITOR_DAILY_LIMIT=
# 预算状态文件路径（默认 <项目根>/data/real_api_budget.json，重启不清零）
TRACEPILOT_REAL_BUDGET_PATH=
# 费用估算用单价（人民币/百万 Token；仅估算，不是 Provider 账单）
TRACEPILOT_PRICE_INPUT_CNY_PER_M=1.0
TRACEPILOT_PRICE_OUTPUT_CNY_PER_M=2.0

# --- 管理员认证（V2；上传/删除/真实实验接口） ---
# 服务端管理员令牌（只放环境变量/Secrets，不写入仓库与前端）
TRACEPILOT_ADMIN_TOKEN=
# 1=上传/删除/真实实验强制管理员会话；0=仅本地开发（默认）
TRACEPILOT_ADMIN_REQUIRED=

# --- 公开演示（V2） ---
# 1=公开空间允许真实 API（需 ALLOW_REAL_API=1 且预算为正）；0/未设置=禁止
TRACEPILOT_PUBLIC_REAL_API=

# --- 可观测性导出（V2.1，可选；默认关闭，不影响生产镜像） ---
# 1=允许真实发送到 OTLP 后端；未设置时 CLI 只允许 dry-run
TRACEPILOT_LANGFUSE_ENABLED=
# 自托管 LangFuse 地址（自动拼 /api/public/otel/v1/traces）；也可用 OTEL_ENDPOINT 覆盖完整路径
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
TRACEPILOT_OTEL_ENDPOINT=
# 无 Basic 鉴权时可用 Bearer；自定义头格式 Key1=Value1,Key2=Value2
TRACEPILOT_OTEL_TOKEN=
TRACEPILOT_OTEL_HEADERS=
TRACEPILOT_OTEL_SERVICE_NAME=
TRACEPILOT_OTEL_TIMEOUT=
TRACEPILOT_OTEL_MAX_RETRIES=
TRACEPILOT_OTEL_BATCH_TRACES=
TRACEPILOT_OTEL_MAX_ATTR_CHARS=

# --- 测试数据库（可选） ---
# 项目测试数据库路径；相对路径以项目根为基准，留空使用默认值 backend/data/tracepilot.db
TRACEPILOT_DB_PATH=

# --- 真实 API 与执行预算（可选） ---
# 服务端真实 API 开关：1=允许（每次请求仍需 confirm_real=true）；0/未设置=一律拒绝
TRACEPILOT_ALLOW_REAL_API=
# 执行限额环境：local=本地宽松预算（24000 token / 2048 输出 / 6 工具轮 / 180s）；
# production=严格预算（4000 token / 512 输出 / 3 工具轮 / 90s）。未设置默认 production。
TRACEPILOT_ENV=

# --- 公网部署（Render 生产环境；本地留空） ---
# 1=公共演示模式：强制禁止匿名真实 DeepSeek API（即使误设 ALLOW 也不放行）
TRACEPILOT_PUBLIC_DEMO=
# 按 IP 限流（生产建议开启；本地/测试保持关闭）
TRACEPILOT_RATE_LIMIT_ENABLED=
TRACEPILOT_RATE_LIMIT_GENERAL_PER_MINUTE=
TRACEPILOT_RATE_LIMIT_HEAVY_PER_MINUTE=
# Render 反向代理后使用 X-Forwarded-For 识别访客 IP
TRACEPILOT_TRUST_PROXY=
# 前端正式域名（逗号分隔；Vercel 部署后填写）
TRACEPILOT_CORS_ORIGINS=
# 容器持久化数据目录（Render 需挂载磁盘到 /app/data）
TRACEPILOT_DATA_DIR=

