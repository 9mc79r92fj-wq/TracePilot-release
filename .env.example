# TracePilot 运行配置模板
# 使用方法：复制本文件为 .env 后填写；.env 已被 git 忽略，切勿提交真实密钥。

# --- DeepSeek API（必填） ---
# API Key（在 DeepSeek 开放平台生成，绝不提交到仓库）
DEEPSEEK_API_KEY=
# API 地址（OpenAI 兼容端点）
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名（deepseek-chat 支持 Function Calling；如需推理模型可换 deepseek-reasoner）
DEEPSEEK_MODEL=deepseek-chat
# 单次模型调用超时（秒）
DEEPSEEK_TIMEOUT=60

# --- 测试数据库（可选） ---
# 项目测试数据库路径；相对路径以项目根为基准，留空使用默认值 backend/data/tracepilot.db
TRACEPILOT_DB_PATH=

# --- 真实 API 与执行预算（可选） ---
# 服务端真实 API 开关：1=允许（每次请求仍需 confirm_real=true）；0/未设置=一律拒绝
TRACEPILOT_ALLOW_REAL_API=
# 执行限额环境：local=本地宽松预算（24000 token / 2048 输出 / 6 工具轮 / 180s）；
# production=严格预算（4000 token / 512 输出 / 3 工具轮 / 90s）。未设置默认 production。
TRACEPILOT_ENV=

# --- 公网部署（Render 生产环境；本地留空） ---
# 1=公共演示模式：强制禁止匿名真实 DeepSeek API（即使误设 ALLOW 也不放行）
TRACEPILOT_PUBLIC_DEMO=
# 按 IP 限流（生产建议开启；本地/测试保持关闭）
TRACEPILOT_RATE_LIMIT_ENABLED=
TRACEPILOT_RATE_LIMIT_GENERAL_PER_MINUTE=
TRACEPILOT_RATE_LIMIT_HEAVY_PER_MINUTE=
# Render 反向代理后使用 X-Forwarded-For 识别访客 IP
TRACEPILOT_TRUST_PROXY=
# 前端正式域名（逗号分隔；Vercel 部署后填写）
TRACEPILOT_CORS_ORIGINS=
# 容器持久化数据目录（Render 需挂载磁盘到 /app/data）
TRACEPILOT_DATA_DIR=

