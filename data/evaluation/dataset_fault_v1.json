        "tool": "calculator",
        "arguments": {
          "expression": "125*48"
        },
        "fault": {
          "type": "tool_timeout",
          "count": 9
        },
        "max_retries": 2
      },
      "expected_outcome": {
        "answer_match": {
          "type": "numeric",
          "expected": 6000,
          "tolerance": 0.0001
